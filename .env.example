# Shared
NODE_ENV=development
LOG_LEVEL=info

# Control Plane (Neon or local Postgres)
CONTROL_PLANE_DATABASE_URL=postgres://rudra:rudra@localhost:5432/rudra_control
CONTROL_PLANE_PORT=4000
SECRETS_ENCRYPTION_KEY=dev-only-change-me-32chars-min!!

# Service ports
POSTGRES_API_PORT=4001
MONGODB_API_PORT=4002
GRAPHQL_API_PORT=4003
REALTIME_API_PORT=4004
WEBRTC_API_PORT=4005
FILE_API_PORT=4006
FUNCTION_API_PORT=4007
PDF_GENERATOR_API_PORT=4008

# Postgres API — persist datasource/resource registry across restarts (Render)
# Can point at the same Neon DB as your app data; metadata uses schema rudra_meta.
POSTGRES_METADATA_URL=postgres://rudra:rudra@127.0.0.1:5432/rudra_data
POSTGRES_METADATA_ENCRYPTION_KEY=dev-only-change-me-32chars-min!!

# Auth
JWT_SECRET=dev-jwt-secret-change-me

# PDF Generator API — Firebase Auth
# Production: set project credentials (or GOOGLE_APPLICATION_CREDENTIALS / emulator).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Local/testing without Firebase:
# PDF_GENERATOR_AUTH_MODE=test

# Optional: MongoDB Atlas / local
MONGODB_URL=mongodb://localhost:27017/rudra

# Optional: GraphQL upstreams
GRAPHQL_PG_main=http://127.0.0.1:4001/api/v1/postgres/main
GRAPHQL_MONGO_main=http://127.0.0.1:4002/api/v1/mongodb/main
GRAPHQL_REST_ALLOWLIST=*
FUNCTION_API_URL=http://127.0.0.1:4007

# Optional: Function API upstreams
POSTGRES_API_URL=http://127.0.0.1:4001/api/v1/postgres
MONGODB_API_URL=http://127.0.0.1:4002/api/v1/mongodb
FILE_API_URL=http://127.0.0.1:4006/api/v1/files

# Optional: TURN (Coturn)
TURN_URL=turn:turn.example.com:3478
TURN_SECRET=turn-shared-secret
TURN_USERNAME=rudra
