    "@rudra/errors": "workspace:*",
    "@rudra/logging": "workspace:*",
    "@rudra/rate-limit": "workspace:*",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "express": "^4.21.2",
    "firebase-admin": "^13.2.0",
    "handlebars": "^4.7.8",
    "multer": "^1.4.5-lts.2",
    "pdfkit": "^0.16.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/pdfkit": "^0.13.9",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
