{
  "name": "@rudra/postgres-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --import tsx --conditions=development src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rudra/auth": "workspace:*",
    "@rudra/config": "workspace:*",
    "@rudra/contracts": "workspace:*",
    "@rudra/errors": "workspace:*",
    "@rudra/logging": "workspace:*",
    "@rudra/metadata": "workspace:*",
    "@rudra/policies": "workspace:*",
    "@rudra/postgres-driver": "workspace:*",
    "@rudra/rate-limit": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
